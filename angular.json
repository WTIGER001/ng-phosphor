{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "analytics": false
  },
  "projects": {
    "ng-phosphor": {
      "projectType": "library",
      "root": "projects/ng-phosphor",
      "sourceRoot": "projects/ng-phosphor/src",
      "prefix": "ph",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ng-phosphor/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-phosphor/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-phosphor/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "demo": {
      "projectType": "application",
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/demo/src/main.ts",
            "tsConfig": "projects/demo/tsconfig.app.json",
            "index": "projects/demo/src/index.html",
            "outputPath": "dist/demo",
            "styles": [
              "projects/demo/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "500kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "demo:build:development"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "demo:build:development",
            "tsConfig": "projects/demo/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
